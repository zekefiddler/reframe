#!/bin/bash
set -euo pipefail

# Who runs reFrame and where it lives. install.sh writes /etc/default/reframe
# (root-owned); the defaults below are upstream's dedicated "cam" user.
REFRAME_USER="cam"
REFRAME_GROUP="cam"
REFRAME_REPO="/home/cam/reframe"
if [ -f /etc/default/reframe ]; then
    # shellcheck source=/dev/null
    . /etc/default/reframe
fi

if [ "$(id -u)" -ne 0 ]; then
    echo "reframe-apply-update must run as root" >&2
    exit 1
fi

if ! [[ "$REFRAME_USER" =~ ^[a-z_][a-z0-9_-]*$ && "$REFRAME_GROUP" =~ ^[a-z_][a-z0-9_-]*$ ]]; then
    echo "Invalid REFRAME_USER or REFRAME_GROUP in /etc/default/reframe" >&2
    exit 1
fi
if ! [[ "$REFRAME_REPO" =~ ^/[A-Za-z0-9._/-]+$ ]]; then
    echo "Invalid REFRAME_REPO in /etc/default/reframe" >&2
    exit 1
fi
REFRAME_HOME="$(getent passwd "$REFRAME_USER" | cut -d: -f6)"
if [ -z "$REFRAME_HOME" ]; then
    echo "User $REFRAME_USER does not exist" >&2
    exit 1
fi

REPO_PATH="$REFRAME_REPO"
VENV_PATH="$REPO_PATH/.venv"

required_files=(
    requirements.txt
    scripts/enable_hdr.sh
    scripts/reframe-apply-update
    scripts/reframe-python
    systemd/reframe.service
    systemd/reframe-dashboard.service
    systemd/reframe-dashboard-proxy.service
)

for required in "${required_files[@]}"; do
    if [ ! -f "$REPO_PATH/$required" ]; then
        echo "Missing update file: $required" >&2
        exit 1
    fi
done

if ! dpkg-query -W -f='${Status}' python3-venv 2>/dev/null | grep -q "install ok installed"; then
    apt-get update -qq
    DEBIAN_FRONTEND=noninteractive apt-get install -y -qq python3-venv
fi

runuser -u "$REFRAME_USER" -- env HOME="$REFRAME_HOME" /usr/bin/python3 -m venv --system-site-packages "$VENV_PATH"
runuser -u "$REFRAME_USER" -- env HOME="$REFRAME_HOME" PYTHONNOUSERSITE=1 "$VENV_PATH/bin/python" -m pip install -r "$REPO_PATH/requirements.txt"

# The unit files in the repo name the "cam" user and /home/cam/reframe; fill in this install's.
render_unit() {
    sed -e "s|/home/cam/reframe|$REFRAME_REPO|g" \
        -e "s|^User=cam$|User=$REFRAME_USER|" \
        -e "s|^Group=cam$|Group=$REFRAME_GROUP|" \
        "$REPO_PATH/systemd/$1" > "/etc/systemd/system/$1"
    chmod 0644 "/etc/systemd/system/$1"
}

install -o root -g root -m 0755 "$REPO_PATH/scripts/reframe-apply-update" /usr/local/sbin/reframe-apply-update
render_unit reframe.service
render_unit reframe-dashboard.service
render_unit reframe-dashboard-proxy.service
install -d -o root -g root -m 0755 /var/lib/reframe
chmod 0755 "$REPO_PATH/scripts/enable_hdr.sh"
chmod 0755 "$REPO_PATH/scripts/reframe-python"

systemctl daemon-reload

echo "Dependencies and service files updated; reboot to run the new code."
